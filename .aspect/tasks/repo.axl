# Repo-level AXL tasks. These become `aspect <name>` subcommands once registered
# in //MODULE.aspect via use_task(). AXL is a typed Starlark dialect; see the
# `ctx` API (ctx.bazel.*, ctx.std.*, ctx.args.*) at https://docs.aspect.build/cli.
#
# Two patterns are demonstrated below:
#   - Shelling out to an existing script/binary (`check`, `fmt` wrap ./lint.sh).
#   - Driving Bazel natively through the first-class API (`test_all`).

def _run_lint(ctx, mode):
    """Invoke the repo's lint.sh orchestrator in the given mode."""
    # lint.sh derives its own REPO_ROOT, so it works from any cwd inside the
    # workspace. root_dir() is the directory containing MODULE.aspect.
    script = ctx.std.env.root_dir() + "/lint.sh"
    proc = ctx.std.process.command(script).args(["--mode", mode])
    return proc.spawn().wait().code

def _check_impl(ctx):
    return _run_lint(ctx, "check")

check = task(
    description = "Check formatting and lint (wraps ./lint.sh --mode check).",
    implementation = _check_impl,
    args = {},
)

def _fmt_impl(ctx):
    return _run_lint(ctx, "format")

fmt = task(
    description = "Auto-format the tree (wraps ./lint.sh --mode format).",
    implementation = _fmt_impl,
    args = {},
)

def _test_all_impl(ctx):
    # ctx.bazel.test drives Bazel directly (honoring .bazelrc). Not named `test`
    # because the CLI ships a built-in `test` task already.
    return ctx.bazel.test(*ctx.args.target_pattern).wait().code

test_all = task(
    description = "Run tests via Bazel (defaults to //...).",
    implementation = _test_all_impl,
    args = {
        "target_pattern": args.positional(minimum = 0, maximum = 512, default = ["//..."]),
    },
)
